# Copy to .env and adjust for local development:
#   copy .env.example .env

# Required in production — use a long random string
SECRET_KEY=change-me-to-a-random-secret

# Optional: override SQLite location
# DATABASE_URL=sqlite:///cleaning_logs.db

# Flask debug mode (never enable in production)
FLASK_DEBUG=1

# Public URL of the app (used in password-reset emails)
# APP_BASE_URL=http://127.0.0.1:5000

# Password reset link lifetime in hours
# PASSWORD_RESET_EXPIRY_HOURS=1

# Email (SMTP) for password reset — optional; without this, reset links print to the server console
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=1
# MAIL_USERNAME=your@gmail.com
# MAIL_PASSWORD=your-app-password
# MAIL_FROM=your@gmail.com
